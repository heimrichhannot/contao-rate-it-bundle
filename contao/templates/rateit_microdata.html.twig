{#
    RateIt rating widget with schema.org microdata.
    Pass the template name to rateit_rating(id, type, 'rateit_microdata').
#}
<!-- indexer::stop -->
<div itemtype="https://schema.org/CreativeWork" itemscope class="rating-microdata">
    <div id="{{ ratingId }}" class="{{ rateit_class }} {{ skin }} block">
        {% if showBefore %}
            <div id="{{ descriptionId }}" class="ratingText">{{ description }}</div>
        {% endif %}
        <div class="wrapper">
            <div class="rateItRating-selected" style="display: block;"></div>
            <div class="rateItRating-hover"></div>
        </div>
        {% if showAfter %}
            <div id="{{ descriptionId }}" class="ratingText">{{ description }}</div>
        {% endif %}
    </div>
    <span class="rating-microdata" itemprop="name">{{ itemreviewed }}</span>
    <span class="rating-microdata" itemtype="https://schema.org/AggregateRating" itemscope itemprop="aggregateRating">
        <span itemprop="ratingValue">{{ actRating }}</span>
        <span itemprop="worstRating">0</span>
        <span itemprop="bestRating">{{ maxRating }}</span>
        <span itemprop="ratingCount">{{ votes }}</span>
    </span>
</div>
<!-- indexer::continue -->
